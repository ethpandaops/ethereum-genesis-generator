# Test Case 8: invalid EIP-8198 SLOT_DURATION_SCHEDULE
# The epoch 0 entry is derived from SLOT_DURATION_MS, so a user entry at
# epoch 0 is rejected before any EL or CL genesis files are written.
export GENESIS_DELAY=20
export FULU_FORK_EPOCH=0
export SLOT_DURATION_SCHEDULE='[{"epoch": 0, "slot_duration_ms": 6000}]'
