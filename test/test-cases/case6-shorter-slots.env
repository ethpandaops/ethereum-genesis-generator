# Test Case 6: EIP-8198 shorter slots, then a BPO afterwards
# Order: genesis (12s slots) -> Amsterdam + EIP8198 + 6s slots (2) -> BPO_1 (4)
# - amsterdamTime: slot change at the same epoch does not move the fork
#   20 + 2 * 32 * 12 = 788
# - bpo1Time: 2 epochs at 12s + 2 epochs at 6s
#   20 + 2 * 32 * 12 + 2 * 32 * 6 = 1172 (would be 1556 with fixed 12s slots)
# - config.yaml: SLOT_DURATION_SCHEDULE starts at genesis with SLOT_DURATION_MS
export GENESIS_DELAY=20
export SLOT_DURATION_MS=12000
export FULU_FORK_EPOCH=0
export GLOAS_FORK_EPOCH=2
export EIP8198_FORK_EPOCH=2
export SLOT_DURATION_SCHEDULE='[{"epoch": 2, "slot_duration_ms": 6000}]'
export BPO_1_EPOCH=4
export BPO_1_MAX_BLOBS=12
export BPO_1_TARGET_BLOBS=8
# Disable the default BPO_2 schedule inherited from defaults.env
export BPO_2_EPOCH=18446744073709551615
