# Test Case 5: FRAMES_ENABLED with a scheduled Heze fork
# - EL: bogota activates at HEZE_FORK_EPOCH (bogotaTime set in genesis.json)
# - CL: Heze fork is disabled (HEZE_FORK_EPOCH pinned to max uint64 in config.yaml)
export GENESIS_DELAY=20
export SLOT_DURATION_MS=6000
export FULU_FORK_EPOCH=0
export GLOAS_FORK_EPOCH=1
export HEZE_FORK_EPOCH=2
export FRAMES_ENABLED=true
