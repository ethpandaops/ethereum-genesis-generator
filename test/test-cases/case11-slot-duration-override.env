# Test Case 11: SLOT_DURATION_MS=6000 on the mainnet preset, SLOT_DURATION_SCHEDULE not set
# - config.yaml: default schedule is a single 6000 ms entry at epoch 0
# - amsterdamTime: 20 + 64 epochs * 32 slots * 6s = 12308
export GENESIS_DELAY=20
export FULU_FORK_EPOCH=0
export SLOT_DURATION_MS=6000
export GLOAS_FORK_EPOCH=64
