# Test Case 7: EIP-8198 multi-step slot duration schedule, given unsorted
# Eras: 12s from genesis, 8s from epoch 2, 4s from epoch 4
# - bpo1Time (epoch 3): 20 + 2 * 32 * 12 + 1 * 32 * 8 = 1044
# - bpo2Time (epoch 6): 20 + 2 * 32 * 12 + 2 * 32 * 8 + 2 * 32 * 4 = 1556
# - config.yaml: SLOT_DURATION_SCHEDULE entries sorted by epoch
export GENESIS_DELAY=20
export SLOT_DURATION_MS=12000
export FULU_FORK_EPOCH=0
export EIP8198_FORK_EPOCH=2
export SLOT_DURATION_SCHEDULE='[{"epoch": 4, "slot_duration_ms": 4000}, {"epoch": 0, "slot_duration_ms": 12000}, {"epoch": 2, "slot_duration_ms": 8000}]'
export BPO_1_EPOCH=3
export BPO_1_MAX_BLOBS=12
export BPO_1_TARGET_BLOBS=8
export BPO_2_EPOCH=6
export BPO_2_MAX_BLOBS=18
export BPO_2_TARGET_BLOBS=12
